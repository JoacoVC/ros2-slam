<?xml version="1.0"?>
<robot name="three_wheel_robot" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:property name="body_mass" value="1.0"/>
  <xacro:property name="wheel_mass" value="0.2"/>
  <xacro:property name="caster_mass" value="0.1"/>
  <xacro:property name="r" value="0.05"/>
  <xacro:property name="wheel_width" value="0.03"/>
  <xacro:property name="c" value="0.35"/> 
  <xacro:property name="b" value="0.25"/> 
  <xacro:property name="h" value="0.06"/> 
  <xacro:property name="d" value="0.05"/> 

  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12}" ixy="0" ixz="0" iyy="${m*(x*x+z*z)/12}" iyz="0" izz="${m*(x*x+y*y)/12}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+h*h)/12}" ixy="0" ixz="0" iyy="${m*(3*r*r+h*h)/12}" iyz="0" izz="${m*r*r/2}"/>
    </inertial>
  </xacro:macro>

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="body_link"/>
    <origin xyz="0 0 ${r + d}" rpy="0 0 0"/>
  </joint>

  <link name="body_link">
    <visual>
      <geometry><box size="${c} ${b} ${h}"/></geometry>
    </visual>
    <collision>
      <geometry><box size="${c} ${b} ${h}"/></geometry>
    </collision>
    <xacro:box_inertia m="${body_mass}" x="${c}" y="${b}" z="${h}"/>
  </link>

  <xacro:macro name="wheel" params="prefix reflect">
    <link name="wheel_${prefix}_link">
      <visual>
        <origin rpy="1.5707 0 0"/>
        <geometry><cylinder radius="${r}" length="${wheel_width}"/></geometry>
      </visual>
      <collision>
        <origin rpy="1.5707 0 0"/>
        <geometry><cylinder radius="${r}" length="${wheel_width}"/></geometry>
      </collision>
      <xacro:cylinder_inertia m="${wheel_mass}" r="${r}" h="${wheel_width}"/>
    </link>

    <joint name="wheel_${prefix}_joint" type="continuous">
      <parent link="body_link"/>
      <child link="wheel_${prefix}_link"/>
      <origin xyz="-0.12 ${reflect * 0.14} -${d}"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel prefix="left" reflect="1"/>
  <xacro:wheel prefix="right" reflect="-1"/>

  <link name="caster_link">
    <visual>
      <geometry><sphere radius="${r}"/></geometry>
    </visual>
    <collision>
      <geometry><sphere radius="${r}"/></geometry>
    </collision>
    <inertial>
      <mass value="${caster_mass}"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="body_link"/>
    <child link="caster_link"/>
    <origin xyz="0.18 0 -${d}"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
    </visual>
    
    <collision>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
    </collision>
    
    <xacro:cylinder_inertia m="0.1" r="0.05" h="0.04"/>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="body_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.1 0 0.05" rpy="0 0 0"/>
  </joint>

  <gazebo reference="lidar_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>

  <xacro:include filename="$(find mobile_robot)/model/robot.gazebo"/>

</robot>